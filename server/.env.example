# ============================================================
#  SAGE TRADING -- Environment Variables
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your real keys below
#  3. NEVER commit .env to git
# ============================================================

# --- Alpaca (Primary: stocks, crypto, paper trading) ---
ALPACA_API_KEY=PASTE_YOUR_ALPACA_KEY_HERE
ALPACA_SECRET_KEY=PASTE_YOUR_ALPACA_SECRET_HERE
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADE_URL=https://paper-api.alpaca.markets

# --- Twelve Data (Fallback + Forex + Futures) ---
TWELVE_DATA_API_KEY=PASTE_YOUR_TWELVE_DATA_KEY_HERE
TWELVE_DATA_URL=https://api.twelvedata.com

# --- Server ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development
