# ============================================================
#  SAGE TRADING -- Client Environment Variables
#  1. Copy this file:  cp .env.example .env.local
#  2. Fill in your values (leave blank to use Vite dev proxy)
#  3. NEVER commit .env.local to git
# ============================================================

# Backend base URL for production deployments.
# Leave empty in development -- Vite's proxy routes /api/* to localhost:4000.
VITE_API_BASE=

# WebSocket URL for production.
# Leave empty in development -- auto-derived from window.location.host.
VITE_WS_URL=
